FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONPATH=/app/src
RUN apt-get update && apt-get install -y --no-install-recommends python3 ufw iptables nftables iproute2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY src/ /app/src/
COPY tests/ci/ufw_live.py /app/ufw_live.py
COPY tests/ci/nft_live.py /app/nft_live.py
COPY tests/ci/broker_live.py /app/broker_live.py
COPY tests/ci/outbound_live.py /app/outbound_live.py
COPY tests/ci/raw_connection_live.py /app/raw_connection_live.py
COPY tests/ci/ingress_live.py /app/ingress_live.py
CMD ["python3", "/app/ufw_live.py"]
