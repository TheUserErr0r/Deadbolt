#!/usr/bin/env python3
"""Fixed SSH receiver: execute only root-configured commands with argv, never a shell."""

import json
import os
from pathlib import Path
import stat
import sys

MAX_INPUT = 3072
POLICY = Path("/etc/deadbolt/remote-commands.json")


def unique(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate field")
        result[key] = value
    return result


def main() -> int:
    from deadbolt.access import command_argv

    item = POLICY.lstat()
    parent = POLICY.parent.stat()
    if (not stat.S_ISREG(item.st_mode) or item.st_uid != 0 or item.st_mode & 0o022
            or not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022):
        raise ValueError("unsafe remote command policy")
    with POLICY.open("rb") as stream:
        raw_policy = stream.read(4097)
    if len(raw_policy) > 4096:
        raise ValueError("remote command policy too large")
    mapping = json.loads(raw_policy, object_pairs_hook=unique)
    if not isinstance(mapping, dict) or not mapping:
        raise ValueError("invalid remote command policy")
    for name, path in mapping.items():
        if (not isinstance(name, str) or not isinstance(path, str)
                or not path.startswith("/usr/local/libexec/deadbolt-commands/")
                or ".." in path.split("/")
                or Path(path).name in {"sh", "bash", "zsh", "dash", "env", "sudo", "su"}):
            raise ValueError("invalid remote command policy")
        target = Path(path)
        info = target.lstat()
        parent_info = target.parent.stat()
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022
                or not stat.S_ISDIR(parent_info.st_mode) or parent_info.st_uid != 0
                or parent_info.st_mode & 0o022):
            raise ValueError("unsafe remote command executable")
    raw = sys.stdin.buffer.readline(MAX_INPUT + 1)
    if not raw.endswith(b"\n") or len(raw) > MAX_INPUT or sys.stdin.buffer.read(1):
        raise ValueError("invalid command request framing")
    message = json.loads(raw, object_pairs_hook=unique)
    if (not isinstance(message, dict) or set(message) != {"version", "argv"}
            or type(message["version"]) is not int or message["version"] != 1):
        raise ValueError("invalid command request")
    argv = command_argv(message["argv"], allow_sensitive=True)
    if argv[0] not in mapping:
        raise ValueError("command is not permitted")
    executable = mapping[argv[0]]
    os.execve(executable, [executable, *argv[1:]], {"PATH": "/usr/bin:/bin", "LANG": "C"})
    return 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (ValueError, OSError, UnicodeError):
        print("remote command rejected", file=sys.stderr)
        raise SystemExit(126)
